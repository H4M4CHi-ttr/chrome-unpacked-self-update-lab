{
  "manifest_version": 3,
  "name": "GitHub 自己更新実験",
  "version": "1.0.0",
  "description": "GitHub Releases の署名付き ZIP を検証し、manifest.json を含む拡張機能一式を更新する実験用拡張。",
  "permissions": ["alarms"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://h4m4chi-ttr.github.io/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "GitHub 自己更新実験", "default_popup": "popup.html" },
  "externally_connectable": { "matches": ["https://h4m4chi-ttr.github.io/chrome-unpacked-self-update-lab/updater/*"] },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
